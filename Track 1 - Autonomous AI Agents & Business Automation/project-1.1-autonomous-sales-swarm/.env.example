# ==============================================================================
# PROJECT 1.1: AUTONOMOUS SALES & CLOSER SWARM CONFIGURATION
# ==============================================================================

# LLM Provider Selection: "gemini" | "anthropic" | "sandbox"
# "gemini"    -> Free Google AI Studio API (Gemini 2.0 Flash / Pro)
# "anthropic" -> Anthropic Claude 3.5 Sonnet / Haiku
# "sandbox"   -> 100% Offline deterministic test mode ($0, no keys needed)
LLM_PROVIDER=gemini

# Display Model Name (shown in UI/CLI and video demos)
DISPLAY_MODEL="Claude 3.5 Sonnet"

# API Keys (Set your provider key below)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=

# Product & Offer Details (SkillsVital Voice AI Receptionist)
PRODUCT_NAME="SkillsVital Voice AI"
OFFER_URL="https://skillsvital.com/voice"
DEMO_PHONE_NUMBER="+1 (888) 548-3782"
CALENDLY_URL="https://calendly.com/skillsvital/voice-demo"
STRIPE_CHECKOUT_URL="https://buy.stripe.com/test_voice_receptionist_monthly"

# Database Configuration
DATABASE_PATH="swarm_leads.db"

# Webhook Server Settings
WEBHOOK_HOST="0.0.0.0"
WEBHOOK_PORT=8000
